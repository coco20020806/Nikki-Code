VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# 仅 Vercel 服务端（如 /api/push-test 全服推送），勿暴露到前端
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
VITE_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_FOR_SERVERLESS

# Web Push（浏览器订阅用公钥，需与下方私钥成对；可用 npx web-push generate-vapid-keys）
VITE_VAPID_PUBLIC_KEY=

# 服务端发送推送（Vercel /api/push-test）；公钥可与 VITE_VAPID_PUBLIC_KEY 相同内容
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
